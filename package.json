  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "graygate-cypher": "^1.0.4",
    "node-forge": "^1.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.11",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
